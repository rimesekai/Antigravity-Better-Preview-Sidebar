{
  "command": "node",
  "args": ["run.mjs"],
  "restart_policy": "always",
  "display_name": "File Preview",
  "description": "在侧边栏高保真预览本地 PPT（.pptx）、Word（.docx）、PDF（.pdf，支持 >20MB 大文件流式预览）、MP4（.mp4，支持 >20MB 视频流式播放）与 HTML（.html/.htm）文件。",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "File Preview",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "File Preview",
        "file_extensions": [".pptx", ".docx", ".html", ".htm", ".pdf", ".mp4"]
      }
    ]
  }
}
