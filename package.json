{
  "name": "file-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Antigravity 侧边栏 PPT / Word / Excel / PDF / MP4 / HTML 文件预览插件",
  "scripts": {
    "build:ui": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:ui && npm run build:server",
    "test": "node --test tests/server.test.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "docx-preview": "^0.4.1",
    "pdfjs-dist": "3.11.174",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@aiden0z/pptx-renderer": {
      "pdfjs-dist": "$pdfjs-dist"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
